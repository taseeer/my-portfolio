code src/App.js

# Step 2: Rebuild
npm run build

# Step 3: Deploy (Netlify)
# Option A: Drag new build folder to Netlify
# Option B: Connect GitHub for auto-deploy

# Step 4: Clear browser cache (Ctrl+Shift+R)
